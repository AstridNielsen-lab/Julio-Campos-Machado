import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 Olá, sou Julio Campos Machado!</h1>
			<p>
				Bem-vindo ao meu portfólio! Sou locutor da Rádio Tatuapé FM (88,8 MHz) há mais de 15 anos
				e fundador da Like Look Solutions, uma empresa especializada em soluções de TI.
