---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <!-- Hero Section -->
    <section class="hero-section text-white py-20">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div data-aos="fade-right">
            <h1 class="text-5xl font-bold mb-6">Julio Campos Machado</h1>
            <p class="text-xl mb-8">Especialista em TI, Locutor e Empreendedor</p>
            <a href="#contato" class="btn bg-white text-blue-600 hover:bg-gray-100">
              Fale Comigo
            </a>
          </div>
          <div data-aos="fade-left" class="hidden md:block">
            <img src="/avatar.jpg" alt="Julio Campos Machado" class="rounded-full w-80 h-80 mx-auto shadow-xl">
          </div>
        </div>
      </div>
    </section>

    <!-- Rest of the content remains the same -->
    <section class="py-20 bg-gray-50" id="servicos">
      <!-- ... -->
    </section>

    <section class="py-20" id="contato">
      <!-- ... -->
    </section>

    <Footer />
    <Chatbot />

    <script>
      import AOS from 'aos';
      AOS.init({
        duration: 1000,
        once: true
      });
    </script>

    <style>
      .hero-section {
        background: linear-gradient(rgba(37, 99, 235, 0.9), rgba(67, 56, 202, 0.9)), url('/tecno.gif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
      }
    </style>
  </body>
</html>
