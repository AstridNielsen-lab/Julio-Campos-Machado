---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white py-20">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div data-aos="fade-right">
            <h1 class="text-5xl font-bold mb-6">Julio Campos Machado</h1>
            <p class="text-xl mb-8">Especialista em TI, Locutor e Empreendedor</p>
            <a href="#contato" class="btn bg-white text-blue-600 hover:bg-gray-100">
              Fale Comigo
            </a>
          </div>
          <div data-aos="fade-left" class="hidden md:block">
            <img src="/avatar.jpg" alt="Julio Campos Machado" class="rounded-full w-80 h-80 mx-auto shadow-xl">
          </div>
        </div>
      </div>
    </section>

    <!-- Serviços -->
    <section class="py-20 bg-gray-50" id="servicos">
      <div class="container">
        <h2 class="section-title" data-aos="fade-up">Serviços Like Look Solutions</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="card p-6" data-aos="fade-up" data-aos-delay="100">
            <h3 class="text-xl font-bold mb-4">Service Desk</h3>
            <p>Suporte técnico especializado para sua empresa</p>
          </div>
          <div class="card p-6" data-aos="fade-up" data-aos-delay="200">
            <h3 class="text-xl font-bold mb-4">Field Support</h3>
            <p>Atendimento presencial qualificado</p>
          </div>
          <div class="card p-6" data-aos="fade-up" data-aos-delay="300">
            <h3 class="text-xl font-bold mb-4">Consultoria</h3>
            <p>Soluções estratégicas em TI</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contato -->
    <section class="py-20" id="contato">
      <div class="container">
        <h2 class="section-title" data-aos="fade-up">Entre em Contato</h2>
        <div class="grid md:grid-cols-2 gap-12">
          <div class="card p-8" data-aos="fade-right">
            <h3 class="text-2xl font-bold mb-6">Informações de Contato</h3>
            <ul class="space-y-4">
              <li class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span>(11) 97060-3441 | (11) 99294-6628</span>
              </li>
              <li class="flex items-center">
                <svg class="w-6 h-6 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <a href="mailto:contato@likelook.com.br">contato@likelook.com.br</a>
              </li>
            </ul>
          </div>
          <div class="card p-8" data-aos="fade-left">
            <h3 class="text-2xl font-bold mb-6">Redes Sociais</h3>
            <div class="grid grid-cols-2 gap-4">
              <a href="https://www.linkedin.com/in/juliocamposmachado" target="_blank" class="btn btn-primary">
                LinkedIn
              </a>
              <a href="https://github.com/AstridNielsen-lab" target="_blank" class="btn btn-primary">
                GitHub
              </a>
              <a href="https://x.com/JulioScouter" target="_blank" class="btn btn-primary">
                Twitter
              </a>
              <a href="https://www.instagram.com/radiotatuapefm" target="_blank" class="btn btn-primary">
                Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
    <Chatbot />

    <script>
      import AOS from 'aos';
      AOS.init({
        duration: 1000,
        once: true
      });
    </script>
  </body>
</html>